BIND_ADDR=0.0.0.0:8080
APP_ENV=development
DATABASE_URL=postgres://enigma:enigma_dev_password@postgres:5432/enigma
DATABASE_MAX_CONNECTIONS=10
REDIS_URL=redis://redis:6379
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL_SECONDS=3600
CORS_ALLOWED_ORIGINS=*
MAX_JSON_BODY_BYTES=1048576
MAX_CIPHERTEXT_BYTES=262144
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
MESSAGE_TTL_SECONDS=604800
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=enigma-attachments
S3_FORCE_PATH_STYLE=true
S3_UPLOAD_PRESIGN_TTL_SECONDS=900
S3_DOWNLOAD_PRESIGN_TTL_SECONDS=900
ATTACHMENT_TTL_SECONDS=604800
MAX_ATTACHMENT_BYTES=104857600
TURN_SHARED_SECRET=turn_dev_shared_secret
TURN_REALM=enigma.local
TURN_CREDENTIAL_TTL_SECONDS=600
TURN_URIS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
PUSH_PROVIDER=noop
# FCM production only:
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_JSON_PATH=
# FCM_SERVICE_ACCOUNT_JSON=
# Android sideload update manifest. Leave ANDROID_APK_URL empty to disable.
# ANDROID_RELEASE_CHANNEL=stable
# ANDROID_LATEST_VERSION_NAME=1.0.0
# ANDROID_LATEST_VERSION_CODE=1
# ANDROID_APK_URL=
# ANDROID_APK_SHA256=
# ANDROID_APK_SIGNATURE=
# ANDROID_UPDATE_MANDATORY=false
# ANDROID_RELEASE_NOTES_FR=
# ANDROID_RELEASE_NOTES_EN=
RUST_LOG=enigma_e2ee_server=info,tower_http=info
SERVER_PORT=8080
POSTGRES_PORT=15432
REDIS_PORT=16379
MINIO_PORT=19000
MINIO_CONSOLE_PORT=19001
TURN_PORT=3478
OFFICIAL_RELAY_MODE=false
ENIGMA_ADMIN_TOKEN=change-me-long-random-secret-at-least-32-bytes
SUPPORT_ENABLED=true
DONATION_URL_FR=https://example.org/don
DONATION_URL_EN=https://example.org/donate
DONATION_URL_DEFAULT=https://example.org/donate
PREMIUM_URL_FR=https://example.org/premium
PREMIUM_URL_EN=https://example.org/premium
PREMIUM_URL_DEFAULT=https://example.org/premium
ATTACHMENT_PENDING_TTL_SECONDS=3600
ATTACHMENT_UNATTACHED_TTL_SECONDS=86400
ATTACHMENT_PURGE_BATCH_SIZE=500
FREE_UPLOAD_DAILY_BYTES=262144000
FREE_UPLOAD_DAILY_COUNT=100
