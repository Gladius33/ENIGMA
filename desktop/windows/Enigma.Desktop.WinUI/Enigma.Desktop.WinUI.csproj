<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Enigma.Desktop.WinUI</RootNamespace>
    <ApplicationIcon />
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <EnigmaCoreNativePath Condition="'$(EnigmaCoreNativePath)' == ''">$(MSBuildProjectDirectory)\..\..\target\release\enigma_core.dll</EnigmaCoreNativePath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <ProjectReference Include="..\Enigma.Desktop.Interop\Enigma.Desktop.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\android\app\src\main\res\drawable-nodpi\enigma_logo.png">
      <Link>Assets\enigma_logo.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="$(EnigmaCoreNativePath)">
      <Link>enigma_core.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="RequireEnigmaCoreNative" BeforeTargets="PrepareForBuild">
    <Error
      Condition="!Exists('$(EnigmaCoreNativePath)')"
      Text="ENIGMA native core is missing. Build desktop/crates/enigma-ffi in release mode before building the WinUI client." />
  </Target>
</Project>
